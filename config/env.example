# Copy to ~/.config/mlb-report/.env and chmod 600.
# Secrets only — recipients live in user.json.
# In CI these are supplied as environment variables instead, which take precedence.

SMTP_HOST=smtp.porkbun.com
SMTP_PORT=587
SMTP_USER=mlb-report@yourdomain.com
SMTP_PASSWORD=
MAIL_FROM=mlb-report@yourdomain.com
